#!/bin/bash
# Forced command of the T3 Recorder upload key on the Mac mini: takes one recording as a tar on stdin, nothing else.
# Called by ssh with SSH_ORIGINAL_COMMAND="<id> replace|add". replace swaps the folder, add puts files into it.
set -euo pipefail
ROOT="${RECORDINGS_ROOT:-$HOME/share/recordings}"
read -r id mode extra <<<"${SSH_ORIGINAL_COMMAND:-}"
[[ "$id" =~ ^r-[0-9]{8}-[0-9]{6}$ ]] || { echo "bad recording id" >&2; exit 2; }
[[ "$mode" == replace || "$mode" == add ]] && [[ -z "${extra:-}" ]] || { echo "bad mode" >&2; exit 2; }
mkdir -p "$ROOT"
target="$ROOT/$id"
if [[ "$mode" == add ]]; then
  [[ -d "$target" ]] || { echo "unknown recording" >&2; exit 2; }
  /usr/bin/tar -xf - -C "$target"
else
  incoming=$(mktemp -d "$ROOT/.incoming.XXXXXX")
  trap 'rm -rf "$incoming"' EXIT
  /usr/bin/tar -xf - -C "$incoming"
  chmod 755 "$incoming"
  rm -rf "$target"
  mv "$incoming" "$target"
  trap - EXIT
fi
